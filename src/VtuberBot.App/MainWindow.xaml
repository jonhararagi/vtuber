<Window x:Class="VtuberBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VTuberBot" Width="1360" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#0B0E17" Foreground="#F1F5F9">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#151A2A"/>
    <SolidColorBrush x:Key="Surface2" Color="#1D2438"/>
    <SolidColorBrush x:Key="Muted" Color="#98A4BE"/>
    <SolidColorBrush x:Key="Accent" Color="#69D8F2"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#252E46"/>
      <Setter Property="BorderBrush" Value="#34415E"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#101525"/>
      <Setter Property="BorderBrush" Value="#34415E"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="CaretBrush" Value="#69D8F2"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#111827"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#101525"/><Setter Property="Foreground" Value="#F1F5F9"/>
      <Setter Property="BorderBrush" Value="#29334D"/><Setter Property="Padding" Value="6"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#101423" BorderBrush="#222B42" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True" Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,24">
          <TextBlock Text="VTuberBot" FontSize="24" FontWeight="Bold" Foreground="#69D8F2"/>
          <TextBlock Text="CREATOR STUDIO  •  LOCAL FIRST" FontSize="9" Foreground="#98A4BE" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="8,12,8,8">
          <TextBlock Text="{Binding ConnectionSummary}" Foreground="#98A4BE" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Button Content="⚙  Ajustes" Tag="Ajustes" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <TextBlock Text="Producto integral · candidato de trabajo" FontSize="10" Foreground="#697692" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NavigationPanel">
            <Button Content="◈  Inicio" Tag="Inicio" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="✧  Avatar Studio" Tag="Avatar Studio" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="◉  Twitch y chat" Tag="Twitch y chat" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="⌘  Comandos" Tag="Comandos" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="♧  Comunidad y puntos" Tag="Comunidad y puntos" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="✦  Sorteos" Tag="Sorteos" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="♜  Minijuegos" Tag="Minijuegos" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="⛨  Moderación" Tag="Moderación" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="♫  Voz y audio" Tag="Voz y audio" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="▣  OBS" Tag="OBS" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="▤  Telegram Web" Tag="Telegram Web" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
            <Button Content="≋  Actividad y diagnóstico" Tag="Actividad y diagnóstico" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,22,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Inicio" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Text="Tu centro de operaciones para el stream." Foreground="#98A4BE" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#172E35" BorderBrush="#285866" BorderThickness="1" CornerRadius="14" Padding="12,7" Margin="0,0,8,0">
            <TextBlock x:Name="RuntimeStatus" Text="●  LOCAL ACTIVO" Foreground="#8FE6D0" FontSize="11" FontWeight="SemiBold"/>
          </Border>
          <Button Content="Actualizar" Click="Refresh_Click"/>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="Workspace"/>
      </ScrollViewer>
      <TextBlock Grid.Row="2" x:Name="FooterStatus" Text="Los estados externos solo cambian cuando existe una conexión real." Foreground="#7F8AA5" FontSize="11" Margin="0,14,0,0"/>
    </Grid>
  </Grid>
</Window>
